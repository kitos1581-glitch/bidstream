rules_version = '2';

// BidStream — Reglas de Firebase Storage
service firebase.storage {
  match /b/{bucket}/o {

    // Por defecto, todo cerrado.
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Fotos de lotes: cada vendedor sube a su propia carpeta.
    // Máximo 10 MB por foto y solo imágenes.
    // Lectura pública: el catálogo se ve sin cuenta. (Las URL de descarga
    // con token ya funcionan sin sesión; esta regla cubre el acceso directo.)
    match /lots/{uid}/{fileName} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Documentos de identidad (INE frente/reverso y selfie).
    // PRIVADOS: solo el dueño y los administradores pueden verlos.
    match /verifications/{uid}/{fileName} {
      allow read: if request.auth != null
        && (request.auth.uid == uid || request.auth.token.admin == true);
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if false;
    }

    // Foto de perfil.
    match /users/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
