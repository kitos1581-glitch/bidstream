{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "functions",
      "ignore": [
        "node_modules",
        "test",
        "*.local",
        ".env.example"
      ]
    }
  ],
  "storage": [
    {
      "bucket": "bidstream-656cf.firebasestorage.app",
      "rules": "storage.rules"
    }
  ],
  "hosting": {
    "public": "web_build",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/l/**",
        "function": {
          "functionId": "lotPreview",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
