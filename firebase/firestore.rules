rules_version = '2';

// =====================================================================
// BidStream — Reglas de seguridad de Firestore (con pagos / escrow)
// ---------------------------------------------------------------------
// Principio: el celular NUNCA escribe precios, pujas ni datos de pago.
// Las pujas pasan por la Cloud Function `placeBid`; los pagos por las
// funciones de payments.js y el webhook de Mercado Pago.
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function emailVerified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    // Administradores: custom claim admin == true (scripts/set_admin.js).
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function notBanned() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid))
        .data.get('banned', false) != true;
    }

    // Validación COMPLETA de un lote. Se usa al crear y al actualizar.
    function validLotData(d) {
      return d.title is string && d.title.size() >= 3 && d.title.size() <= 120
        && d.get('description', '') is string && d.get('description', '').size() <= 3000
        && d.category is string && d.category.size() >= 1 && d.category.size() <= 60
        && d.get('image_urls', []) is list && d.get('image_urls', []).size() <= 10
        && d.get('stream_url', '') is string && d.get('stream_url', '').size() <= 500
        && d.starting_price is number && d.starting_price > 0 && d.starting_price <= 50000000
        && d.minimum_increment is number && d.minimum_increment > 0
        && d.minimum_increment <= 50000000
        && d.current_bid is number && d.current_bid >= d.starting_price
        && d.current_bid <= 50000000
        && d.bid_count is int && d.bid_count >= 0
        && d.start_time is timestamp && d.end_time is timestamp
        && d.start_time < d.end_time
        && d.end_time <= d.start_time + duration.value(60, 'd')
        && d.format in ['timed', 'live']
        && d.get('condition', 'used_good') in
             ['new', 'like_new', 'used_good', 'used_fair', 'for_parts']
        && d.get('specs', {}) is map && d.get('specs', {}).size() <= 30
        && d.seller_uid is string;
    }

    // Identidad verificada (INE aprobada por un admin).
    function identityVerified() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid))
        .data.get('verified', false) == true;
    }

    // Solo cambian los campos indicados.
    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // ---------------- Usuarios (datos privados) ----------------
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      // El usuario crea su propio perfil, pero no puede auto-verificarse,
      // darse rol de administrador ni falsificar su depósito/strikes.
      allow create: if isOwner(uid)
        && !request.resource.data.keys().hasAny(
              ['verified', 'role', 'banned', 'deposit', 'strikes',
               'verification_status', 'ban_reason']);

      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['verified', 'role', 'banned', 'uid', 'created_time',
                       'deposit', 'strikes', 'verification_status', 'ban_reason']);

      allow delete: if false;

      // Notificaciones: las crea el servidor; el usuario solo las lee
      // y las marca como leídas.
      match /notifications/{notificationId} {
        allow read: if isOwner(uid);
        allow update: if isOwner(uid) && onlyChanges(['read']);
        allow delete: if isOwner(uid);
        allow create: if false;
      }

      // Tokens de notificaciones push de sus dispositivos.
      // El id del documento ES el token; solo se guarda la plataforma y fecha.
      match /fcm_tokens/{token} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['platform', 'updated_time'])
          && token.size() < 512;
      }

      // Contador de usos del asistente de IA (lo lleva el servidor).
      match /ai_usage/{day} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Subastas en las que participa (las mantiene el servidor).
      match /bidding/{lotId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    // ---------------- Lotes ----------------
    match /lots/{lotId} {
      allow read: if true; // Catálogo público: se puede ver sin cuenta.

      // Para vender: correo verificado, identidad verificada (INE), cuenta
      // no suspendida, y datos válidos (MISMA validación que al actualizar).
      allow create: if emailVerified()
        && identityVerified()
        && notBanned()
        && validLotData(request.resource.data)
        && request.resource.data.seller_uid == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.bid_count == 0
        && request.resource.data.current_bid == request.resource.data.starting_price
        && request.resource.data.end_time > request.time
        && !request.resource.data.keys().hasAny(
              ['highest_bidder_uid', 'highest_bidder_name', 'winner_uid', 'winner_name',
               'payment_status', 'winner_payment_url', 'payment_due_time', 'amount_due',
               'deposit_applied', 'final_price', 'seller_name', 'cancel_reason']);

      // El vendedor solo edita la parte descriptiva. Precio, incremento y
      // fechas solo mientras NO haya pujas. El documento resultante pasa por
      // la misma validación que al crear (evita, p. ej., incrementos negativos).
      allow update: if isOwner(resource.data.seller_uid)
        && notBanned()
        && resource.data.status == 'active'
        && validLotData(request.resource.data)
        && (
          onlyChanges(['title', 'description', 'category', 'image_urls', 'stream_url',
                       'condition', 'specs'])
          || (resource.data.bid_count == 0
              && onlyChanges(['title', 'description', 'category', 'image_urls',
                              'stream_url', 'condition', 'specs', 'starting_price', 'current_bid',
                              'minimum_increment', 'end_time', 'start_time', 'format'])
              && request.resource.data.current_bid == request.resource.data.starting_price
              && request.resource.data.end_time > request.time)
        );

      // Solo se puede borrar un lote que nadie ha pujado.
      allow delete: if isOwner(resource.data.seller_uid) && resource.data.bid_count == 0;

      // Ofertas proxy: contienen el MÁXIMO SECRETO (max_amount).
      // Cada quien solo puede leer las suyas (las consultas deben filtrar
      // por user_id == su uid). Solo el servidor escribe.
      match /bids/{bidId} {
        allow read: if signedIn() && resource.data.user_id == request.auth.uid;
        allow write: if false;
      }

      // Historial público de pujas (sin máximos). Solo el servidor escribe.
      match /history/{entryId} {
        allow read: if true; // Historial público (sin máximos secretos).
        allow write: if false;
      }

      // Estado interno del proxy (líder y su máximo). Nadie lo lee desde la app.
      match /private/{docId} {
        allow read, write: if false;
      }
    }

    // ---------------- Pagos (solo el servidor) ----------------
    // Depósitos, pagos de ganador, reembolsos y payouts. El dueño puede
    // leer los suyos; nadie escribe desde el cliente.
    match /payments/{paymentId} {
      allow read: if (signedIn() && resource.data.uid == request.auth.uid) || isAdmin();
      allow write: if false;
    }

    // ---------------- Verificación de identidad ----------------
    // La crea/actualiza el servidor (submitIdentityVerification).
    match /verifications/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    // Bitácora de acciones de administradores.
    match /admin_log/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Todo lo demás, cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
